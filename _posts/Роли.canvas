{
	"nodes":[
		{"id":"438710df00b8ff5d","type":"text","text":"ДКБ","x":-125,"y":280,"width":250,"height":60},
		{"id":"d4b71cfa498a48a2","type":"text","text":"ДЗИС","x":125,"y":280,"width":250,"height":60},
		{"id":"d8964e9821bf614e","type":"text","text":"ДКБ Корпората","x":-420,"y":280,"width":250,"height":60},
		{"id":"07814b3a23feb96b","type":"text","text":"Руководитель ДКБ","x":-420,"y":190,"width":250,"height":60},
		{"id":"e4d3e460d3b2c438","type":"text","text":"Семья Симато","x":0,"y":-260,"width":250,"height":60},
		{"id":"c2e3d7d7c097f26f","type":"text","text":"Совет","x":0,"y":-160,"width":250,"height":60},
		{"id":"b41a2cef24bdb16f","type":"text","text":"Руководитель Департамента Корпоративной Безопасности, в его задачи входит оперативная реакция на возникающие угрозы и информирование ЭКБ о ситуации, так же составление инструкций на возможные угрозы и своевременное их предотвращение.","x":-496,"y":-40,"width":403,"height":190},
		{"id":"69dfbb387105df5c","type":"text","text":"Эксперты КБ","x":-420,"y":380,"width":250,"height":60},
		{"id":"b7da22c71cd5c162","type":"text","text":"Эксперты Корпоративной Безопасности, это сотрудники оценивающие риски операций и организующие ОтКБ и ОСН, если угроза внешнего характера, то операцией курируют Эксперты Корпоративной Безопасности.","x":-496,"y":480,"width":403,"height":190},
		{"id":"46e8ba083095d2a2","type":"text","text":"ДКБ Объекта","x":-700,"y":280,"width":250,"height":60},
		{"id":"bbdb850cb3fe8dc8","type":"text","text":"Руководитель Безопасности Объекта","x":-1020,"y":280,"width":250,"height":60},
		{"id":"f2531692e06b9a77","type":"text","text":"Операторы Безопасности Сектора","x":-1020,"y":190,"width":250,"height":60},
		{"id":"88e0b71277658a9e","type":"text","text":"Офицер КБ","x":-1020,"y":380,"width":250,"height":60},
		{"id":"55da6bf650ab60f1","type":"text","text":"Руководитель Безопасности Объекта, это лица руководящие приписанными на объекте офицерами КБ, в его задачи входит обеспечение безопасности зоны, объекта, сотрудников, и важных активов.","x":-1520,"y":215,"width":403,"height":190},
		{"id":"7cb1feb7e6bb6a0d","type":"text","text":"Операторы Безопасности Сектора, это сотрудники поддерживающие связь с Руководителями Безопасности Объектов и оценивающие безопасность объектов в секторе.","x":-1520,"y":20,"width":403,"height":190},
		{"id":"c2cf5ffe7c53443e","type":"text","text":"Офицер Корпоративной Безопасности, Это лица обеспечивающие безопасность на объекте, если офицер не приписан к объекту, он считается свободным и его могут приписать в ОтКБ.","x":-1520,"y":410,"width":403,"height":190},
		{"id":"2e21abe181add0b9","type":"text","text":"Операторы Специальных Операций","x":440,"y":190,"width":250,"height":60},
		{"id":"d11ea3364352a187","type":"text","text":"Эксперты Специальных Операций","x":440,"y":380,"width":250,"height":60},
		{"id":"d4740713254fa92d","type":"text","text":"Руководитель ДЗИС","x":440,"y":280,"width":250,"height":60},
		{"id":"e98bf54d2bcf46f7","type":"text","text":"Руководитель департамента, в его задачи входит руководство департаментом, информирование ОСО о указах выше, предотвращение угроз для интеллектуальной собственности корпорации, составление операций на варианты чрезвычайных ситуаций.","x":780,"y":215,"width":403,"height":190},
		{"id":"0abb23ea4a251213","type":"text","text":"ЭСО, эксперты своего дела, в их задачи входит организация наиболее эффективного выполнения задач, информирование отряда о плане и ситуации, составление отчета для ОСО, так же поддержание связи с активным отрядом.","x":780,"y":420,"width":403,"height":190},
		{"id":"6b2b8bb201881659","type":"text","text":"В задачи ОСО входит составление, организация и выполнение операций после указания руководителя ДЗИС, ОСО информирует ЭСО о задачах и ситуации и передает ему командование над ОСН или ОтКБ в зависимости от задачи.","x":780,"y":0,"width":403,"height":190},
		{"id":"a42cf88f16a59fbe","type":"text","text":"ОтКБ","x":145,"y":1222,"width":250,"height":60},
		{"id":"eaa5f45b16cb6344","type":"text","text":"Лидер ОтКБ","x":440,"y":1222,"width":250,"height":60},
		{"id":"3dd191cb489653e5","type":"text","text":"Медик ОтКБ","x":780,"y":1222,"width":250,"height":60},
		{"id":"56e49f5a3483b160","type":"text","text":"Офицер ОтКБ","x":780,"y":1300,"width":250,"height":60},
		{"id":"32028f2cc92f731e","type":"text","text":"ЭСО, эксперты своего дела, в их задачи входит организация наиболее эффективного выполнения задач, информирование отряда о плане и ситуации, составление отчета для ОСО, так же поддержание связи с активным отрядом.","x":364,"y":920,"width":403,"height":190},
		{"id":"9195cb80113b64d7","type":"text","text":"Инженер ОтКБ","x":780,"y":1140,"width":250,"height":60},
		{"id":"fd5eb151e8ad2d43","type":"text","text":"Медик отряда выполняет функции полевого медика во время непосредственного выполнения операции, медик ОтКБ обязан подготовить медицинский реанимационный инвентарь и выдать каждому по набору первой помощи.","x":1080,"y":1157,"width":403,"height":190},
		{"id":"63f816ae18c1cadb","type":"text","text":"Офицер отряда выполняет функции боевой единицы, он подчиняется лидеру ОтКБ, офицер ОтКБ обязан эффективно выполнить поставленную задачу от лидера ОтКБ и достичь цели операции с минимальными затратами на ее выполнение.","x":1080,"y":1360,"width":403,"height":190},
		{"id":"45363cae90d9138a","type":"text","text":"Инженер следит за состоянием вооружения, снаряжения и обмундирования отряда, он обязан уметь пилотировать шаттл и механоидов всех типов, обеспечивать свободный путь для отряда, и руководить АМЕ.","x":1080,"y":950,"width":403,"height":190},
		{"id":"d3a36c64cba3f714","type":"text","text":"Последняя надежда","x":-571,"y":976,"width":250,"height":60},
		{"id":"9808321456582cdd","type":"text","text":"Падший ангел","x":-571,"y":1062,"width":250,"height":60},
		{"id":"7eba4be42c543cdd","type":"text","text":"Божья десница","x":-571,"y":1142,"width":250,"height":60},
		{"id":"6580555d45bab3ba","type":"text","text":"Слепое дитя","x":-571,"y":1222,"width":250,"height":60},
		{"id":"5e70ea990bec3b28","type":"text","text":"Короли тишины","x":-571,"y":1302,"width":250,"height":60},
		{"id":"bf5efefe43fd36a3","type":"text","text":"Грибные шляпки","x":-571,"y":1382,"width":250,"height":60},
		{"id":"3bbb5976e4fce1ba","type":"text","text":"Железные сердца","x":-571,"y":1462,"width":250,"height":60},
		{"id":"88ee98f4b045a4a6","type":"text","text":"ОСН","x":-148,"y":1222,"width":250,"height":60},
		{"id":"558fcaddebb923e9","type":"text","text":"Силовые структуры быстрого реагирования","x":0,"y":736,"width":250,"height":60},
		{"id":"751bffbcc534370d","type":"text","text":"Отряд сформированный для выполнения операций проходящих в неблагоприятных условиях, они специалисты РБХ опасностей и их отряд создан для их устранения.","x":-1200,"y":1620,"width":360,"height":180},
		{"id":"cc908c88dd18e9d3","x":-1200,"y":1820,"width":360,"height":180,"type":"text","text":"Отряд сформированный для выполнения операций проходящих в условиях невозможных для пребывания, восприятия, выполнения задач для сотрудника АнКо, отряд состоит из боевых Рипсоидов различных классов."},
		{"id":"3bf2359ab942ec6d","type":"text","text":"Отряд сформированный для выполнения скрытных операций, в основном проходящих в темноте, их снаряжение тихое и не оставляющее следов, цель отряда выполнить задачу и не оставить никаких улик.","x":-1196,"y":1422,"width":360,"height":180},
		{"id":"5c8ca0f13c42d3c9","type":"text","text":"Отряд сформированный из различного штата сотрудников, они хотят веселья, хотят шоу и операции без особого риска не приносят им удовольствия, и им это не нравится.","x":-1196,"y":1222,"width":360,"height":180},
		{"id":"58ec1f49f13c9bf6","type":"text","text":"Офицер Титан, по совместительству шикарный политик и юрист, отряд сформирован для выполнения операций требующих опытного бойца способного представлять Корпорат.","x":-1196,"y":1022,"width":360,"height":180},
		{"id":"f85170a728727753","type":"text","text":"Отряд сформированный из одного сотрудника Офицера Титана, для которого служба Корпорату больше чем работа, это религия, и его святой долг выполнить все что он укажет.","x":-1196,"y":816,"width":360,"height":180},
		{"id":"6e47c183d7069721","type":"text","text":"Отряд сформированный для выполнения особо сложных операций требующих особого подхода, состоит исключительно из Офицеров Титанов.","x":-1196,"y":620,"width":360,"height":180}
	],
